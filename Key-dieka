    -- Hiệu ứng viền 7 màu cho nút Menu
    local function ApplyRainbowBorderToButton()
        pcall(function()
            local toggleButton = game:GetService("CoreGui"):FindFirstChild("WindUI_Main_Gui")
            if toggleButton then
                toggleButton = toggleButton:FindFirstChild("Toggle")
                if toggleButton then
                    local rainbowGradient = Instance.new("UIGradient")
                    rainbowGradient.Name = "RainbowGradient"
                    rainbowGradient.Color = ColorSequence.new{
                        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
                        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 127, 0)),
                        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
                        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
                        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(139, 0, 255))
                    }
                    rainbowGradient.Parent = toggleButton
                    
                    local runService = game:GetService("RunService")
                    local startTime = tick()
                    local duration = 3
                    local speed = 0.5
                    
                    local connection
                    connection = runService.Heartbeat:Connect(function()
                        local elapsed = tick() - startTime
                        if elapsed < duration then
                            local offset = (elapsed * speed) % 1
                            rainbowGradient.Offset = Vector2.new(offset - 1, 0)
                        else
                            pcall(function() rainbowGradient:Destroy() end)
                            if connection then connection:Disconnect() end
                        end
                    end)
                end
            end
        end)
    end

    task.spawn(ApplyRainbowBorderToButton)

